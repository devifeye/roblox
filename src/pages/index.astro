---
//src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { getVideos, pickHero, pickRecent, playerData } from '../lib/videos';
import { site, mailto } from '../config/site';

const videos = await getVideos();
const hero = pickHero(videos);
const recent = pickRecent(videos, 3);

const steps = [
  {
    title: 'Send your script and audio',
    text: 'Email the script, the voiceover, and links to a few of your best videos so the pacing matches your channel.',
  },
  {
    title: 'Scenes get built and animated',
    text: 'I build the sets, pose and animate the characters, and time every shot to your voiceover.',
  },
  {
    title: 'You review the draft',
    text: 'You get a full draft to watch and send notes on. Changes go straight back into the edit.',
  },
  {
    title: 'You get the final file',
    text: 'A finished 9:16 video, ready to upload to YouTube Shorts, TikTok or Reels.',
  },
];
---

<Layout>
  <section class="hero studs" aria-labelledby="hero-title">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <h1 class="hero__title" id="hero-title">
          <span class="hero__line"><span>Roblox stories,</span></span>
          <span class="hero__line"><span>animated to keep</span></span>
          <span class="hero__line"><span>people watching.</span></span>
        </h1>
        <p class="lede hero__lede">
          I'm {site.name}, a one-person animation studio in {site.location}. Send me your script and voiceover,
          and I'll turn them into a fast-paced, 9:16 animated video ready for YouTube Shorts, TikTok and Reels.
        </p>
        <div class="btn-row hero__actions">
          <a class="btn btn--primary" href="/portfolio">Watch the portfolio</a>
          <a class="btn" href={mailto}>Email me</a>
        </div>
      </div>

      {
        hero && (
          <div class="reel">
            <div class="reel__slab" aria-hidden="true" />
            <div class="reel__frame">
              {hero.preview ? (
                <video
                  class="reel__media"
                  src={hero.preview}
                  poster={hero.poster}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-hidden="true"
                />
              ) : (
                <img class="reel__media" src={hero.poster} alt="" width="720" height="1280" />
              )}
              <button class="reel__play" type="button" {...playerData(hero)}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5v14l11-7z" fill="currentColor" />
                </svg>
                <span>{hero.preview ? 'Play with sound' : 'Play'}</span>
                <span class="sr-only">: {hero.title}</span>
              </button>
            </div>
          </div>
        )
      }
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="section" aria-labelledby="recent-title">
        <div class="wrap">
          <div class="section__head">
            <h2 id="recent-title">Recent work</h2>
            <a class="text-link" href="/portfolio">
              See all {videos.length} videos
            </a>
          </div>
          <div class="recent">
            {recent.map((video) => (
              <VideoCard video={video} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section exchange" aria-labelledby="exchange-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="exchange-title">What you send, what you get back</h2>
      </div>
      <div class="exchange__grid">
        <div class="exchange__col">
          <h3>You send</h3>
          <ul class="bricks">
            <li>Your script</li>
            <li>Your voiceover or audio track</li>
            <li>Links to your best-performing videos, so the style and pacing match your channel</li>
          </ul>
        </div>
        <div class="exchange__col exchange__col--get">
          <h3>You get back</h3>
          <ul class="bricks bricks--blue">
            <li>Scenes and characters animated to your script</li>
            <li>A fast-paced vertical edit timed to your voiceover</li>
            <li>A 9:16 video file, ready to upload</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section process" aria-labelledby="process-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="process-title">How a video gets made</h2>
      </div>
      <ol class="stairs">
        {
          steps.map((step, i) => (
            <li class="stairs__step">
              <div class="stairs__brick" aria-hidden="true">
                <span>{i + 1}</span>
              </div>
              <h3 class="stairs__title">
                <span class="sr-only">Step {i + 1}: </span>
                {step.title}
              </h3>
              <p class="stairs__text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section about" aria-labelledby="about-title">
    <div class="wrap about__grid">
      <div>
        <h2 id="about-title">One person, start to finish</h2>
        <p class="lede about__text">
          There's no account manager and no outsourced team. The person you email is the person animating your
          video, so your notes go straight into the edit without getting lost along the way.
        </p>
      </div>
      <dl class="facts">
        <div class="facts__row">
          <dt>Based in</dt>
          <dd>{site.location}</dd>
        </div>
        <div class="facts__row">
          <dt>Format</dt>
          <dd>Vertical 9:16</dd>
        </div>
        <div class="facts__row">
          <dt>Made for</dt>
          <dd>YouTube Shorts, TikTok, Reels</dd>
        </div>
        <div class="facts__row">
          <dt>Contact</dt>
          <dd><a href={mailto}>{site.email}</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="cta on-studio" aria-labelledby="cta-title">
    <div class="wrap cta__inner">
      <div>
        <h2 id="cta-title">Have a script ready?</h2>
        <p class="cta__text">
          Send it with your voiceover and a link to your channel. I'll reply with whether it's a fit and when I can
          start.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href={mailto}>Email {site.email}</a>
        <CopyEmail class="btn--studio" />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero: the baseplate. Its thick lower edge is the side of the plate. */
  .hero {
    border-bottom: 14px solid var(--plate-edge);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.55fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero__title {
    font-size: var(--step-4);
    line-height: 0.98;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero__line > span {
    display: inline-block;
    animation: drop-in 360ms var(--snap) both;
  }

  .hero__line:nth-child(2) > span {
    animation-delay: 140ms;
  }

  .hero__line:nth-child(3) > span {
    animation-delay: 280ms;
  }

  @keyframes drop-in {
    from {
      transform: translateY(-105%);
    }
  }

  .hero__lede {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    color: var(--ink-2);
    animation: fade-in 300ms ease 520ms both;
  }

  .hero__actions {
    margin-top: 2rem;
    animation: fade-in 300ms ease 620ms both;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  /* The reel: a 9:16 screen sitting on a blue brick */
  .reel {
    position: relative;
    width: min(100% - 18px, 20rem);
    justify-self: center;
    animation: place 420ms var(--snap) 380ms both;
  }

  @keyframes place {
    from {
      transform: translateY(-48px);
      opacity: 0;
    }
  }

  .reel__slab {
    position: absolute;
    inset: 0;
    background: var(--blue);
    border-radius: 14px;
    transform: translate(18px, 18px);
    box-shadow: 0 8px 0 var(--blue-deep);
    animation: slab-out 360ms var(--snap) 760ms both;
  }

  @keyframes slab-out {
    from {
      transform: translate(0, 0);
    }
  }

  .reel__frame {
    position: relative;
    aspect-ratio: 9 / 16;
    padding: 10px;
    background: var(--studio);
    border-radius: 14px;
    box-shadow: 0 8px 0 #15171b;
  }

  .reel__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
    background: #000;
  }

  .reel__play {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.55rem 1rem 0.55rem 0.8rem;
    font: inherit;
    font-size: var(--step--1);
    font-weight: 700;
    font-stretch: 112%;
    color: #fff;
    background: rgb(20 22 26 / 0.85);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 4px;
    transform: translateX(-50%);
    cursor: pointer;
    white-space: nowrap;
  }

  .reel__play svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .reel__play:hover {
    background: var(--blue);
  }

  .reel__play:focus-visible {
    outline-color: var(--yellow);
  }

  /* Recent work */
  .recent {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  /* What you send / get */
  .exchange {
    background: var(--smooth);
    border-block: 1px solid var(--line);
  }

  .exchange__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .exchange__col {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--plate);
    border-radius: 6px;
  }

  .exchange__col--get {
    background: var(--blue-soft);
  }

  .bricks {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .bricks li {
    position: relative;
    padding-left: 2rem;
    max-width: 46ch;
  }

  .bricks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3em;
    width: 1rem;
    height: 0.85rem;
    background: var(--ink-2);
    border-radius: 2px;
    box-shadow: 0 3px 0 var(--ink);
  }

  .bricks--blue li::before {
    background: var(--blue);
    box-shadow: 0 3px 0 var(--blue-deep);
  }

  /* Process: four bricks stacked into a staircase, one per step */
  .stairs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stairs__step {
    display: grid;
    grid-template-rows: 13.5rem auto 1fr;
    align-items: end;
  }

  .stairs__brick {
    display: flex;
    align-items: flex-start;
    height: 5.5rem;
    padding: 0.9rem 1rem;
    color: var(--ink);
    background: var(--plate-edge);
    border-radius: 4px;
    box-shadow: 0 6px 0 #aeb4bd;
  }

  .stairs__step:nth-child(2) .stairs__brick {
    height: 8rem;
  }

  .stairs__step:nth-child(3) .stairs__brick {
    height: 10.5rem;
  }

  .stairs__step:nth-child(4) .stairs__brick {
    height: 13rem;
    color: #fff;
    background: var(--blue);
    box-shadow: 0 6px 0 var(--blue-deep);
  }

  .stairs__brick span {
    font-size: 2rem;
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
  }

  .stairs__title {
    margin-top: 1.6rem;
    font-size: 1.1rem;
    font-stretch: 112%;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .stairs__text {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: 0.98rem;
    align-self: start;
  }

  /* About */
  .about {
    background: var(--smooth);
    border-top: 1px solid var(--line);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .about__text {
    margin-top: 1.5rem;
  }

  .facts {
    margin: 0;
    border-top: 4px solid var(--ink);
  }

  .facts__row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    font-stretch: 92%;
    color: var(--ink-2);
  }

  .facts dd {
    margin: 0;
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .facts a {
    text-decoration-color: var(--blue);
    text-underline-offset: 0.2em;
  }

  /* Closing call to action */
  .cta {
    background: var(--studio);
    color: var(--on-studio);
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem 3rem;
  }

  .cta__text {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--on-studio-2);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  @media (max-width: 960px) {
    .stairs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 3rem;
    }

    .stairs__step {
      grid-template-rows: auto auto 1fr;
    }

    .stairs__step .stairs__brick,
    .stairs__step:nth-child(n) .stairs__brick {
      height: 4.5rem;
    }

    .cta__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .hero__inner,
    .about__grid,
    .exchange__grid {
      grid-template-columns: 1fr;
    }

    .reel {
      width: min(64%, 17rem);
      margin-right: 18px;
    }
  }

  @media (max-width: 640px) {
    .recent {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 62%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }

    .recent > :global(*) {
      scroll-snap-align: start;
    }

    /* On phones the staircase becomes a stack of bars that grow wider each step. */
    .stairs {
      grid-template-columns: 1fr;
      row-gap: 2.25rem;
    }

    .stairs__step:nth-child(n) .stairs__brick {
      height: 3.25rem;
      width: 40%;
      align-items: center;
    }

    .stairs__step:nth-child(2) .stairs__brick {
      width: 55%;
    }

    .stairs__step:nth-child(3) .stairs__brick {
      width: 70%;
    }

    .stairs__step:nth-child(4) .stairs__brick {
      width: 85%;
    }

    .stairs__brick span {
      font-size: 1.5rem;
    }

    .stairs__title {
      margin-top: 1.1rem;
    }

    .facts__row {
      grid-template-columns: 6rem 1fr;
    }
  }
</style>
